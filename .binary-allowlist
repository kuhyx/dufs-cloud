# Binary files permitted inside this repo.
#
# Default rule (see ~/.claude/memories/binary-files.md): binaries live outside
# the workspace. Everything below is an exception because it must physically be
# in the package directory to be built into a shipping artifact — Flutter's
# asset bundler reads `flutter: assets:` relative to the package root, so a file
# kept in a sibling directory simply is not in the APK.
#
# One glob per line; `#` comments and blank lines ignored. Anything binary NOT
# matching a line here does not belong in this repo — move it out instead.

# Android launcher icon, generated by flutter_launcher_icons from the source
# artwork (see app/pubspec.yaml `flutter_launcher_icons:`).
app/assets/icon/*.png
app/android/app/src/main/res/**/*.png

# Bundled pdf.js viewer (app/lib/screens/pdf_screen.dart renders PDFs in a
# WebView from these assets; they are vendored upstream files).
app/assets/pdfjs/**/*.bcmap
app/assets/pdfjs/**/*.pfb
app/assets/pdfjs/**/*.ttf
app/assets/pdfjs/**/*.gif
app/assets/pdfjs/**/*.svg

# Subtitle font for libass. On Android fontconfig cannot see the system fonts,
# so media_kit needs a real .ttf bundled as an asset or embedded ASS subtitles
# render nothing at all (app/lib/services/app_player.dart `_libassConfig`).
app/assets/fonts/subfont.ttf
