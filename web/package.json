{
  "name": "cloud-gallery",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "description": "Media-gallery SPA served by dufs at the self-hosted cloud",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "lint": "astro check && tsc --noEmit && eslint src",
    "preview": "astro preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "dependencies": {
    "@kuhyx/web-ui": "github:kuhyx/utils#web_ui-v0.5.0&path:/web_ui",
    "astro": "7.4.5",
    "jassub": "2.5.23"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.8",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
